# Puerto del servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (Configurar credenciales locales seguras)
DB_USER=usuario_bd
DB_PASSWORD=contrasena_segura_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=GestHor

# JWT Configuration (Generar con: openssl rand -base64 32)
JWT_SECRET=reemplazar_con_clave_secreta_jwt_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=reemplazar_con_clave_secreta_refresh_de_al_menos_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Credenciales de consola GCP)
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secreto
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Session Configuration
SESSION_SECRET=reemplazar_con_clave_secreta_session_de_al_menos_32_caracteres

# URLs de la aplicación
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
APP_NAME=GestHor
APP_URL=http://localhost:5173

# Orígenes permitidos de CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Configuración SMTP (Opcional para correos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@unach.mx
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM_EMAIL=tu_correo@unach.mx
SMTP_TLS_REJECT_UNAUTHORIZED=true
